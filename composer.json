{
  "name": "yansier/landingops",
  "description": "LandingOps offline template tooling and PHP control plane",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1 <9.0",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "ext-zip": "*"
  },
  "autoload": {
    "psr-4": {
      "LandingOps\\": "src/"
    }
  },
  "scripts": {
    "test": "@php tests/run.php",
    "test:mysql": "@php tests/mysql-integration.php"
  },
  "config": {
    "sort-packages": true
  }
}
