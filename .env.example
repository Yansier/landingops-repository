LANDINGOPS_DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=landingops;charset=utf8mb4
LANDINGOPS_DB_USER=landingops_app
LANDINGOPS_DB_PASSWORD=replace-at-runtime
# 必须由管理员确认；留空时 DNS 预检查不会猜测服务器公网地址。
LANDINGOPS_CONFIRMED_PUBLIC_IPV4=
# 逗号分隔的、由运维明确批准的宝塔 HTTPS origin；真实只读请求只能命中此白名单。
LANDINGOPS_BAOTA_ALLOWED_BASE_URLS=
# 仅用于派生候选目录；只读 API 无法确认目录内容时仍返回 needs_attention。
LANDINGOPS_BAOTA_SITE_ROOT=/www/wwwroot/landingops
