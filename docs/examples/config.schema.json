{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:landingops:example:sample-download-page:config:1.0.0",
  "title": "Sample download page configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["pixel_ids", "events", "links", "custom"],
  "properties": {
    "pixel_ids": {
      "type": "array",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      },
      "default": []
    },
    "events": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download", "add_to_cart", "purchase"],
      "properties": {
        "download": {"$ref": "#/$defs/toggle"},
        "add_to_cart": {"$ref": "#/$defs/moneyEvent"},
        "purchase": {"$ref": "#/$defs/moneyEvent"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["download_url", "redirect_url"],
      "properties": {
        "download_url": {"$ref": "#/$defs/nullableHttpsUrl"},
        "redirect_url": {"$ref": "#/$defs/nullableHttpsUrl"}
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "headline": {"type": "string", "maxLength": 120}
      },
      "default": {}
    }
  },
  "$defs": {
    "toggle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean", "default": false}
      }
    },
    "moneyEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "value", "currency"],
      "properties": {
        "enabled": {"type": "boolean", "default": false},
        "value": {"type": "number", "minimum": 0, "default": 1},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "USD"}
      }
    },
    "nullableHttpsUrl": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "format": "uri", "pattern": "^https://"}
      ],
      "default": null
    }
  }
}

