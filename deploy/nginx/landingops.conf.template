# Phase 1L template only. Installation requires explicit operator approval and nginx -t.
server {
    listen 443 ssl http2;
    server_name {{LANDINGOPS_DOMAIN}};
    root {{LANDINGOPS_CURRENT_PATH}}/public;
    index index.html;

    ssl_certificate {{TLS_CERTIFICATE_PATH}};
    ssl_certificate_key {{TLS_PRIVATE_KEY_PATH}};

    location = /healthz { try_files "" @landingops_health; }
    location ^~ /api/ { try_files "" @landingops_api; }

    location @landingops_health {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/health.php;
        fastcgi_pass {{LANDINGOPS_PHP_FPM_UPSTREAM}};
    }

    location @landingops_api {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root/index.php;
        fastcgi_param HTTP_PROXY "";
        fastcgi_pass {{LANDINGOPS_PHP_FPM_UPSTREAM}};
    }

    location / { try_files $uri $uri/ /index.html; }
    location ~ \.php$ { return 404; }
    location ~ /\. { deny all; }
}
