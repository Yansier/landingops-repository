#!/bin/sh
set -efu
export LANG=C LC_ALL=C
umask 077

SOURCE='/www/server/panel/vhost/nginx'
DESTINATION='/var/lib/landingops-audit/site-roots.snapshot'
TEMPORARY='/var/lib/landingops-audit/.site-roots.snapshot.tmp'

[ "$(/usr/bin/id -u)" -eq 0 ] || exit 77
[ -d "$SOURCE" ] && [ ! -L "$SOURCE" ] || exit 78
[ ! -L "$(/usr/bin/dirname "$DESTINATION")" ] || exit 78

config_count=$(/usr/bin/find "$SOURCE" -xdev -type f -name '*.conf' | /usr/bin/wc -l | /usr/bin/tr -d ' ')
unreadable_count=$(/usr/bin/find "$SOURCE" -xdev -type f -name '*.conf' ! -readable | /usr/bin/wc -l | /usr/bin/tr -d ' ')
symlink_count=$(/usr/bin/find "$SOURCE" -xdev -type l -name '*.conf' | /usr/bin/wc -l | /usr/bin/tr -d ' ')
root_declaration_count=$(/usr/bin/find "$SOURCE" -xdev -type f -name '*.conf' -readable -exec /usr/bin/awk '$1=="root" {count++} END {print count+0}' {} + | /usr/bin/awk '{sum+=$1} END {print sum+0}')
non_absolute_root_count=$(/usr/bin/find "$SOURCE" -xdev -type f -name '*.conf' -readable -exec /usr/bin/awk '$1=="root" {gsub(/;/,"",$2); if ($2 !~ /^\//) count++} END {print count+0}' {} + | /usr/bin/awk '{sum+=$1} END {print sum+0}')

{
    printf 'schema_version=landingops-site-roots/1\n'
    printf 'generated_epoch=%s\n' "$(/usr/bin/date +%s)"
    printf 'config_count=%s\n' "$config_count"
    printf 'root_declaration_count=%s\n' "$root_declaration_count"
    printf 'non_absolute_root_count=%s\n' "$non_absolute_root_count"
    printf 'unreadable_count=%s\n' "$unreadable_count"
    printf 'symlink_count=%s\n' "$symlink_count"
    printf '%s\n' '--roots--'
    /usr/bin/find "$SOURCE" -xdev -type f -name '*.conf' -readable -exec /usr/bin/awk '$1=="root" {gsub(/;/,"",$2); if ($2 ~ /^\//) print $2}' {} + | /usr/bin/sort -u
} > "$TEMPORARY"

/usr/bin/chown root:landingops-audit "$TEMPORARY"
/usr/bin/chmod 0440 "$TEMPORARY"
/usr/bin/mv -fT -- "$TEMPORARY" "$DESTINATION"
