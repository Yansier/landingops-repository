{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:landingops:template:minimal-static-download:config:1.0.0",
  "title": "Minimal static template configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["pixel_ids", "events", "links", "custom", "private_note"],
  "properties": {
    "pixel_ids": {
      "type": "array",
      "x-landingops-visibility": "public",
      "maxItems": 10,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "x-landingops-visibility": "public",
        "pattern": "^[A-Za-z0-9_-]{1,64}$"
      }
    },
    "events": {
      "type": "object",
      "x-landingops-visibility": "public",
      "additionalProperties": false,
      "required": ["download", "add_to_cart", "purchase"],
      "properties": {
        "download": {"$ref": "#/$defs/toggle", "x-landingops-visibility": "public"},
        "add_to_cart": {"$ref": "#/$defs/moneyEvent", "x-landingops-visibility": "public"},
        "purchase": {"$ref": "#/$defs/moneyEvent", "x-landingops-visibility": "public"}
      }
    },
    "links": {
      "type": "object",
      "x-landingops-visibility": "public",
      "additionalProperties": false,
      "required": ["download_url", "redirect_url"],
      "properties": {
        "download_url": {"$ref": "#/$defs/nullableHttpsUrl", "x-landingops-visibility": "public"},
        "redirect_url": {"$ref": "#/$defs/nullableHttpsUrl", "x-landingops-visibility": "public"}
      }
    },
    "custom": {
      "type": "object",
      "additionalProperties": false,
      "required": ["headline"],
      "properties": {
        "headline": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "x-landingops-visibility": "public"
        }
      }
    },
    "private_note": {
      "type": "string",
      "maxLength": 200,
      "x-landingops-visibility": "private"
    }
  },
  "$defs": {
    "toggle": {
      "type": "object",
      "x-landingops-visibility": "public",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean", "x-landingops-visibility": "public"}
      }
    },
    "moneyEvent": {
      "type": "object",
      "x-landingops-visibility": "public",
      "additionalProperties": false,
      "required": ["enabled", "value", "currency"],
      "properties": {
        "enabled": {"type": "boolean", "x-landingops-visibility": "public"},
        "value": {"type": "number", "minimum": 0, "x-landingops-visibility": "public"},
        "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "x-landingops-visibility": "public"}
      }
    },
    "nullableHttpsUrl": {
      "x-landingops-visibility": "public",
      "oneOf": [
        {"type": "null", "x-landingops-visibility": "public"},
        {"type": "string", "format": "uri", "pattern": "^https://", "x-landingops-visibility": "public"}
      ]
    }
  }
}
